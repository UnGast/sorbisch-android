<?xml version="1.0" encoding="utf-8"?>
<!-- Selected: connecting (cancel). Activated: recording (stop). Disabled: processing. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/text_disabled" />
    <item android:state_activated="true" android:color="#FFFFFF" />
    <item android:state_selected="true" android:color="@color/primary" />
    <item android:color="#FFFFFF" />
</selector>
