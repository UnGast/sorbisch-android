<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <Button
        android:id="@+id/advanced_back"
        style="@style/Button.Back"
        android:layout_marginStart="12dp"
        android:text="@string/setup_back" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

    <LinearLayout
        style="@style/Page"
        android:animateLayoutChanges="true">

        <Button
            android:id="@+id/toggle_advanced"
            style="@style/Button.Tonal"
            android:text="@string/show_advanced_settings" />

        <LinearLayout
            android:id="@+id/advanced_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/SectionLabel"
                android:text="@string/advanced_settings" />

            <LinearLayout style="@style/Card">

            <TextView
                style="@style/FieldLabel"
                android:paddingTop="0dp"
                                android:text="@string/recognizer_server_url" />

            <EditText
                android:id="@+id/server_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/recognizer_server_hint"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:singleLine="true" />

            <TextView
                style="@style/FieldLabel"
                android:labelFor="@+id/language_spinner"
                android:text="@string/recognition_language" />

            <Spinner
                android:id="@id/language_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/FieldLabel"
                android:labelFor="@+id/recognition_sample_rate"
                android:text="@string/recognition_sample_rate" />

            <Spinner
                android:id="@id/recognition_sample_rate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <CheckBox
                android:id="@+id/continuous_recognition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="@string/continuous_recognition" />

            <TextView android:id="@+id/tts_language_label" style="@style/FieldLabel"
                android:labelFor="@+id/tts_language" android:text="@string/tts_language" android:visibility="gone" />
            <Spinner android:id="@id/tts_language" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:visibility="gone" />

            <TextView
                style="@style/FieldLabel"
                                android:text="@string/tts_url_label" />

            <EditText
                android:id="@+id/tts_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/tts_url_hint"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:singleLine="true" />

            <TextView
                style="@style/FieldLabel"
                android:labelFor="@+id/tts_protocol"
                android:text="@string/tts_protocol_label" />

            <Spinner
                android:id="@id/tts_protocol"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:id="@+id/tts_speaker_fields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/FieldLabel"
                    android:labelFor="@+id/tts_speaker_id"
                    android:text="@string/tts_speaker_label" />

                <EditText
                    android:id="@id/tts_speaker_id"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="textVisiblePassword"
                    android:singleLine="true" />
            </LinearLayout>

            <Button
                android:id="@+id/save_settings"
                style="@style/Button.Primary"
                android:layout_marginTop="20dp"
                android:text="@string/save" />

            <Button android:id="@+id/reset_settings" style="@style/Button.Text" android:text="@string/reset_settings" />
            </LinearLayout>

        <TextView
            style="@style/SectionLabel"
            android:text="@string/recognition_test_label" />

        <LinearLayout style="@style/Card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Button
                android:id="@+id/start_test"
                style="@style/Button.Primary"
                android:layout_marginTop="0dp"
                android:text="@string/start_test" />

            <Button
                android:id="@+id/stop_test"
                style="@style/Button.Tonal"
                android:text="@string/stop" />
        </LinearLayout>

        <TextView
            android:id="@+id/status"
            style="@style/SupportingText"
            android:paddingBottom="8dp"
            android:text="@string/status_idle" />

        <TextView
            android:id="@+id/transcript"
            style="@style/Transcript" />
        </LinearLayout>

        <TextView
            style="@style/SectionLabel"
            android:text="@string/voice_output_section" />

        <LinearLayout style="@style/Card">

        <TextView
            style="@style/FieldLabel"
            android:paddingTop="0dp"
                        android:text="@string/tts_text_label" />

        <EditText
            android:id="@+id/tts_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:hint="@string/tts_text_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine"
            android:maxLines="3"
            android:minLines="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <Button
                android:id="@+id/speak_android"
                style="@style/Button.Primary"
                android:text="@string/speak_android" />

            <Button
                android:id="@+id/stop_speech"
                style="@style/Button.Tonal"
                android:text="@string/stop_speech" />
        </LinearLayout>

        <Button
            android:id="@+id/open_tts_settings"
            style="@style/Button.Tonal"
            android:text="@string/open_tts_settings" />

        <Button
            android:id="@+id/speak_external"
            style="@style/Button.Tonal"
            android:text="@string/speak_external" />
        </LinearLayout>

            <LinearLayout style="@style/Card.List" android:layout_marginTop="28dp">
            <Button
                android:id="@+id/open_service_test"
                style="@style/Button.Row"
                android:text="@string/test_android_service" />
            <Button
                android:id="@+id/expert_diagnostics"
                style="@style/Button.Row"
                android:text="@string/diagnostics_title" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
</LinearLayout>
