<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="16dp">

    <TextView
        style="@style/PageTitle"
        android:text="@string/recognition_service_test" />

    <Button
        android:id="@+id/start_service_test"
        style="@style/Button.Primary"
        android:text="@string/start_service_test" />

    <Button
        android:id="@+id/stop_service_test"
        style="@style/Button.Tonal"
        android:text="@string/stop" />

    <TextView
        android:id="@+id/service_status"
        style="@style/SupportingText"
        android:paddingBottom="8dp"
        android:text="@string/status_idle" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/service_transcript"
            style="@style/Transcript" />
    </ScrollView>
</LinearLayout>
