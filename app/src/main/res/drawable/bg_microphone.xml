<?xml version="1.0" encoding="utf-8"?>
<!-- Ready: blue. Connecting (selected): light blue with cancel icon. Recording (activated): red.
     Processing (disabled): gray. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33000000">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="oval"><solid android:color="@color/disabled_container" /></shape>
            </item>
            <item android:state_activated="true">
                <shape android:shape="oval"><solid android:color="@color/recording" /></shape>
            </item>
            <item android:state_selected="true">
                <shape android:shape="oval"><solid android:color="@color/primary_container" />
                    <stroke android:width="2dp" android:color="@color/primary" /></shape>
            </item>
            <item>
                <shape android:shape="oval"><solid android:color="@color/primary" /></shape>
            </item>
        </selector>
    </item>
</ripple>
