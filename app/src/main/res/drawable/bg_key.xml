<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ripple">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape><corners android:radius="18dp" /><solid android:color="#73FFFFFF" /></shape>
            </item>
            <item>
                <shape><corners android:radius="18dp" /><solid android:color="@color/surface" />
                    <stroke android:width="1dp" android:color="@color/outline" /></shape>
            </item>
        </selector>
    </item>
</ripple>
